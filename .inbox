#!/bin/sh
# copy the queue off the box: snapshot pending.txt as a commit on branch inbox (never main = no Pages build), push. restore: git show origin/inbox:pending.txt > pending.txt
cd "$(dirname "$0")" && exec flock .plock sh -c '
t=$(printf "100644 blob %s\tpending.txt\n" "$(git hash-object -w pending.txt)" | git mktree)
p=$(git rev-parse -q --verify inbox || git rev-parse -q --verify origin/inbox)
[ -n "$p" ] && [ "$t" = "$(git rev-parse "$p^{tree}")" ] && exit 0
git update-ref refs/heads/inbox "$(git commit-tree "$t" ${p:+-p $p} -m inbox)" && git push -q origin inbox'
