#!/bin/sh
# the gate (ssh = auth): ./ok = list pending · ./ok <id> = accept into accepted.txt + commit + push · ./ok rm <id> = reject
cd "$(dirname "$0")" || exit 1
case $1 in '') cat pending.txt; exit;; rm) i=$2;; *) i=$1;; esac
case $i in ''|*[!0-9]*) echo "x bad id"; exit 1;; esac
[ "$1" = rm ] && { flock .lock sed -i "/^$i	/d" pending.txt; ./.inbox; echo "rejected $i"; exit; }
l=$(grep "^$i	" pending.txt | cut -f2-); [ -n "$l" ] || { echo "x no $i"; exit 1; }
printf '%s · %s\n' "$(date +%F)" "$l" >> accepted.txt
git commit -qm "post $i: $l" accepted.txt && git push -q origin main && ./ok rm "$i" >/dev/null && echo "accepted $i · live now, github $(git rev-parse --short HEAD)"
